# Environment Configuration
# Copy this file to .env and update with your actual values
#
# ⚠️  SECURITY WARNING:
# In staging/production, SECRET_KEY, JWT_SECRET_KEY, and JWT_REFRESH_SECRET_KEY
# are REQUIRED. The app will fail to start if they are missing.
# Generate strong secrets with: python -c "import secrets; print(secrets.token_urlsafe(64))"

# Application (Bali-Only Travel Planner)
APP_NAME=Bali Travel Planner
APP_VERSION=1.0.0
APP_DESCRIPTION=AI-Powered Travel Planning for Bali, Indonesia
DEBUG=True
ENVIRONMENT=development  # development, staging, production
DESTINATION_SCOPE=bali

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/travel_planner
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# JWT Security
SECRET_KEY=your-secret-key-change-in-production-use-strong-random-string
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-use-strong-random-string
JWT_REFRESH_SECRET_KEY=your-refresh-secret-key-change-in-production-use-strong-random-string
ALGORITHM=HS256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Redis (Caching & Celery)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=3600
CACHE_TTL_LONG=86400

# External APIs - Bali-Specific
# Visual Crossing Weather API (https://www.visualcrossing.com/)
VISUAL_CROSSING_API_KEY=your_visual_crossing_api_key_here
VISUAL_CROSSING_API_URL=https://weather.visualcrossing.com/VisualCrossingWebServices/rest/services/timeline

# OpenStreetMap Settings (No API key required - but respect rate limits)
OSM_API_URL=https://api.openstreetmap.org/api/0.6
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_USER_AGENT=BaliTravelPlanner/1.0

# AI/ML Services - Langbase (REQUIRED for AI recommendations)
LANGBASE_API_KEY=your_langbase_api_key_here
LANGBASE_PIPE_NAME=bali-travel-planner-recommendation

# AI/ML Services - Cohere (REQUIRED for AI features)
COHERE_API_KEY=your_cohere_api_key_here

# AI/ML Services - Gemini (Optional, for additional AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# AI/ML Services - OpenAI (Optional, for direct integration)
OPENAI_API_KEY=your_openai_api_key_here

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=100

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=logs/app.log

# Monitoring (Optional)
SENTRY_DSN=your-sentry-dsn-for-error-tracking

# ========================================
# PRODUCTION SECURITY NOTES
# ========================================
# 1. Generate strong random secrets:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 2. Use different secrets for each environment
#
# 3. Never commit .env file to version control
#
# 4. Use secrets management service in production:
#    - AWS Secrets Manager
#    - Azure Key Vault
#    - HashiCorp Vault
#
# 5. Rotate secrets regularly
#
# 6. Enable HTTPS in production (set CORS_ORIGINS accordingly)
